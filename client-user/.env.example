# client-user/.env.example
# URLs de los microservicios de AlertaGT. Copia este archivo a .env y ajusta según tu entorno.
# En dispositivo físico usa la IP LAN de tu máquina en vez de localhost (p. ej. http://192.168.0.10:3010/...).

EXPO_PUBLIC_AUTH_URL=http://localhost:3010/api/v1/auth
EXPO_PUBLIC_POSTS_URL=http://localhost:3020/api/v1
EXPO_PUBLIC_NOTIFICATIONS_URL=http://localhost:3021/api/v1
EXPO_PUBLIC_GEO_URL=http://localhost:3022/api/v1
EXPO_PUBLIC_REPUTATION_URL=http://localhost:3023/api/v1
