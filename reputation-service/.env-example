PORT=3023

MONGODB_URI=mongodb://example-host:27017
DATABASE_NAME=AlertaGT_Reputation

# Servicio de Auth para validación de tokens JWT
AUTH_SERVICE_URL=http://example-auth-service/api/v1

# URLs de otros servicios
POSTS_SERVICE_URL=http://example-posts-service/api/v1
NOTIFICATIONS_SERVICE_URL=http://example-notifications-service/api/v1

# Token compartido entre microservicios
SERVICE_TOKEN=example_service_token_replace_me

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:4173

# ── Reglas de reputación (opcionales, tienen valores por defecto) ──
FALSE_REPORT_THRESHOLD=5
PENALTY_PER_FALSE_ALERT=20
WARN_THRESHOLD=40
SUSPEND_THRESHOLD=100
SUSPENSION_DAYS=15
DEFAULT_TRUST_SCORE=70

# ── Recuperación de reputación (la penalización NO es permanente) ──
PENALTY_DECAY_DAYS=30
PENALTY_DECAY_POINTS=5
RECOVERY_MIN_RATING=4
RECOVERY_PER_POSITIVE_RATING=2
RECOVERY_PER_COMMUNITY_HELP=3
