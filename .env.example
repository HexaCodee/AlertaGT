# Configuración de AlertaGT
# Copiar este archivo como .env en cada servicio

# ==========================================
# CONFIGURACIÓN COMÚN
# ==========================================

# Puerto del servicio
PORT=3020

# Entorno (development, production)
NODE_ENV=development

# Token para comunicación inter-servicio
SERVICE_TOKEN=your-super-secret-service-token

# ==========================================
# BASE DE DATOS MONGODB
# ==========================================

# URI de conexión a MongoDB
MONGODB_URI=mongodb://localhost:27017

# Nombre de la base de datos (cambiar por servicio)
DATABASE_NAME=AlertaGT_Posts

# ==========================================
# AUTENTICACIÓN Y AUTORIZACIÓN
# ==========================================

# URL del servicio de autenticación
AUTH_SERVICE_URL=http://localhost:3010/api/v1

# ==========================================
# SERVICIOS EXTERNOS
# ==========================================

# URL del servicio de geolocalización
GEO_SERVICE_URL=http://localhost:3022/api/v1

# URL del servicio de notificaciones
NOTIFICATIONS_SERVICE_URL=http://localhost:3021/api/v1

# ==========================================
# CLOUDINARY (PARA IMÁGENES)
# ==========================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==========================================
# FIREBASE (PARA NOTIFICACIONES PUSH)
# ==========================================

# Archivo de credenciales de Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ==========================================
# RATE LIMITING
# ==========================================

# Número máximo de requests por IP por minuto
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ==========================================
# CORS
# ==========================================

# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==========================================
# LOGGING
# ==========================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# ==========================================
# CONFIGURACIONES POR SERVICIO
# ==========================================

# POSTS SERVICE
# - DATABASE_NAME=AlertaGT_Posts
# - PORT=3020

# GEOLOCATION SERVICE
# - DATABASE_NAME=AlertaGT_Geo
# - PORT=3022

# NOTIFICATIONS SERVICE
# - DATABASE_NAME=AlertaGT_Notifications
# - PORT=3021

# AUTH SERVICE (.NET)
# - ASPNETCORE_ENVIRONMENT=Development
# - MONGODB_URI=mongodb://localhost:27017
# - DATABASE_NAME=AlertaGT_Auth
# - JWT_SECRET=your-super-secret-jwt-key
